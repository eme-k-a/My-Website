{
  "rules": {
    "mostSpecificWins": "When several role globs match a path, the glob with the longest literal prefix wins: src/overlay/ScrollTrack* (R4) beats src/overlay/** (R6); src/museum/exhibits/_kit/** (R3) beats src/museum/exhibits/*/** (R5); review/concepts/** (R2) and review/reports/** (R0) beat review/** (R11).",
    "everyoneMayRead": "Every role may read every path. Writing requires the role's globs or an explicit grant in the WP entry below.",
    "colocatedTests": "A *.test.ts file next to its source, and that folder's __snapshots__, belong to the owner of the folder. R8 owns tests/** and playwright.config.ts.",
    "wpAllow": "A commit whose trailer is 'WP: WP-xx' may create, edit or delete only paths matched by wps['WP-xx'].allow and not matched by wps['WP-xx'].deny. R0's merge script checks every commit against this. Grants on another role's path are listed explicitly in allow and in the brief.",
    "packageJson": "package.json and package-lock.json belong to R10. A WP with packageJsonScripts may change only those keys of the scripts field (PLAN Addendum M0 exception for WP-03 and WP-04, extended by R0 at the WP-00 review to the WPs that replace a 'not implemented yet' stub, WP-06 and WP-07, and to the new 'fonts' key of WP-28). Only R10 changes dependencies and the lockfile.",
    "reports": "Every WP writes exactly one report at review/reports/WP-xx.json (schema in docs/wp/_TEMPLATE.md).",
    "reviewFixes": "Review fixes use the trailer 'WP: F-###' and the allow globs written in docs/wp/F-###.md, which are limited to the owner globs of the affected path.",
    "git": "Only R0 pushes, merges and tags, except: WP-01 creates and pushes the tag legacy-site; WP-33 creates and pushes the tag v1.0.0. R0 tags contracts-v1 after merging WP-02."
  },
