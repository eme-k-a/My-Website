+  approach,
+  assignLights,
+  beamSpecs,
+  DIALOG_DIM,
+  lightPlan,
+  lightTargets,
+  matchLights,
+  rampColor,
+  spotIntensity,
+  spotScaleGoal,
+  targetColor,
+  targetOfStop,
+  type TargetId,
+} from './lightPlan';
+
+const layout = computeLayout(content, new Date('2026-10-15T00:00:00Z'));
+const ramp = tokens.light.ramp;
