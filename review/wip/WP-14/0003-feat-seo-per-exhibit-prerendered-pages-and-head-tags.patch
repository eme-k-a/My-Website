+  html = fill(html, MARKERS.head, entry.headTags({ kind: 'exhibit', id }));
+  html = fill(html, MARKERS.app, entry.renderApp(`/exhibit/${id}/`));
+  html = fill(html, MARKERS.story, entry.renderStory(id));
