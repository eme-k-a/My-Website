+/** Fills the `wall` material's wallWash slot; the returned cleanup empties it again. */
+function fillWallWash(wall: MeshStandardMaterial, wash: Texture): () => void {
+  wall.lightMap = wash;
+  wall.lightMapIntensity = WALL_WASH_INTENSITY;
